<?xml version="1.0"?>
<ruleset name="Sous">
  <description>Drupal coding standards for custom modules and themes.</description>
  <file>web/modules/custom</file>
  <file>web/themes/custom</file>
  <arg name="extensions" value="php,module,inc,install,test,profile,theme,info,txt,md,yml"/>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/bower_components/*</exclude-pattern>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>web/themes/custom/*/dist/*</exclude-pattern>
  <exclude-pattern>web/themes/custom/*/components/*</exclude-pattern>
  <!-- Generated Emulsify files fail these standards; remove exclusions after upstream fixes.
       https://github.com/emulsify-ds/emulsify-drupal/issues/386 -->
  <exclude-pattern>web/themes/custom/*/*.info.yml</exclude-pattern>
  <exclude-pattern>web/themes/custom/*/AGENTS.md</exclude-pattern>
  <exclude-pattern>web/themes/custom/*/README.md</exclude-pattern>
  <exclude-pattern>web/themes/custom/*/docs/upgrading.md</exclude-pattern>
  <exclude-pattern>web/themes/custom/*/docs/development.md</exclude-pattern>
  <exclude-pattern>web/themes/custom/*/docs/drupal-integration.md</exclude-pattern>
  <exclude-pattern>web/themes/custom/*/docs/support-information.md</exclude-pattern>
  <exclude-pattern>web/themes/custom/*/.agents/skills/emulsify-drupal-integration/SKILL.md</exclude-pattern>
  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
