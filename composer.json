{
    "name": "fourkitchens/sous-drupal-project",
    "description": "Starter project for Sous a Drupal distribution featuring a theme based on Emulsify Design System.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "repositories": [
        {
            "type": "composer",
            "url": "https://fourkitchens.github.io/sous-drupal-packages/",
            "canonical": true,
            "only": [
                "fourkitchens/sous-*"
            ]
        },
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        },
        {
            "type": "package",
            "package": {
                "name": "dropzone/dropzone",
                "version": "6.3.5",
                "type": "drupal-library",
                "extra": {
                    "installer-name": "dropzone"
                },
                "dist": {
                    "url": "https://github.com/enyo/dropzone/releases/download/dropzone%406.3.5/dist.zip",
                    "type": "zip"
                }
            }
        }
    ],
    "require": {
        "composer/installers": "^2.3.0",
        "cweagans/composer-patches": "^2.0.0",
        "drupal/core-composer-scaffold": "^11.4.11",
        "drupal/core-project-message": "^11.4.11",
        "drupal/core-recipe-unpack": "^11.4.11",
        "drupal/core-recommended": "^11.4.11",
        "drupal/core-vendor-hardening": "^11.4.11",
        "drupal/login_destination": "^2.0.0-beta10@beta",
        "drush/drush": "^13.8.0",
        "fourkitchens/sous-admin": "^2.0",
        "fourkitchens/sous-emulsify": "^2.0",
        "oomphinc/composer-installers-extender": "^2.0.1",
        "php": "^8.4",
        "webflo/drupal-finder": "^1.3.1",
        "zaporylie/composer-drupal-optimizations": "^1.2.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-recipe-unpack": true,
            "zaporylie/composer-drupal-optimizations": true,
            "oomphinc/composer-installers-extender": true,
            "drupal/core-project-message": true,
            "drupal/core-vendor-hardening": true,
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.4.0"
        },
        "process-timeout": 0
    },
    "extra": {
        "installer-name": "sous",
        "installer-types": [
            "npm-asset",
            "bower-asset",
            "drupal-library",
            "drupal-recipe"
        ],
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/libraries/{$name}": [
                "type:npm-asset",
                "type:drupal-library",
                "vendor:bower-asset"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/recipes/{$name}": [
                "type:drupal-recipe"
            ]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "source": "https://git.drupalcode.org/project/drupal/raw/{version}/{path}",
            "excludes": [
                ".eslintrc"
            ],
            "includes": [
                "sites/default/example.settings.my.php"
            ],
            "file-mapping": {
                "[web-root]/sites/example.settings.local.php": {
                    "append": "assets/scaffold/files/additions-example.settings.local.txt"
                },
                "[web-root]/sites/default/default.settings.php": {
                    "append": "assets/scaffold/files/additions-default.settings.txt"
                },
                "[web-root]/sites/development.services.yml": {
                    "mode": "replace",
                    "path": "assets/scaffold/files/development.services.yml",
                    "overwrite": false
                }
            },
            "omit-defaults": false
        },
        "drupal-core-vendor-hardening": {
            "composer/composer": false
        },
        "composer-patches": {
            "patches-file": "patches/patches.json",
            "package-depths": {
                "drupal/core": 2
            }
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php -r \"@unlink('vendor/bin/composer');\""
        ],
        "post-create-project-cmd": [
            "./devops/scripts/sous-build.sh"
        ],
        "build-assets": [
            "composer install --optimize-autoloader --no-dev",
            "@build-theme"
        ],
        "build-theme": [
            "npm ci --include=dev",
            "npm run theme-ci",
            "npm run theme-build"
        ],
        "ci": [
            "@composer validate --no-check-publish",
            "@composer install",
            "@build-theme",
            "@lint",
            "@code-sniff"
        ],
        "build-storybook": [
            "npm run theme-storybook"
        ],
        "lint": "npm run lint",
        "code-sniff": "phpcs",
        "code-fix": "phpcbf",
        "post-drupal-scaffold-cmd": [
            "test -e web/sites/default/settings.local.php || cp web/sites/example.settings.local.php web/sites/default/settings.local.php",
            "test -e web/sites/default/settings.php || cp web/sites/default/default.settings.php web/sites/default/settings.php"
        ]
    },
    "require-dev": {
        "drupal/coder": "^9.0"
    },
    "scripts-descriptions": {
        "ci": "Install development dependencies, build the theme, lint and check coding standards.",
        "build-assets": "Install production PHP dependencies and build the theme for deployment.",
        "code-sniff": "Check custom modules and themes against Drupal and DrupalPractice standards.",
        "code-fix": "Fix custom module and theme coding standards using phpcs.xml.dist."
    }
}
