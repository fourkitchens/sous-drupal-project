#!/bin/bash

## Description: Run Emulsify CLI inside the web container
## Usage: emulsify [flags] [args]
## Example: "ddev emulsify system list" or "ddev emulsify system install emulsify-ui-kit"
## HostWorkingDir: true
## ExecRaw: true

set -euo pipefail

if [[ ! -x /var/www/html/node_modules/.bin/emulsify ]]; then
  echo "Emulsify CLI is not installed. Run 'ddev npm ci --include=dev' in the project root." >&2
  exit 1
fi
exec /var/www/html/node_modules/.bin/emulsify "$@"
