 namespace Drupal\Tests\tablefield\Functional;
 
+use Drupal\field\Entity\FieldConfig;
 use Drupal\Tests\BrowserTestBase;
 
 /**
@@ -21,7 +22,7 @@ class TableValueFieldTest extends BrowserTestBase {
   /**
    * {@inheritdoc}
    */
