   /**
+   * Builds an options list of all text formats configured on the site.
+   *
+   * Loads FilterFormat entities via the entity type manager and returns an
+   * associative array keyed by the format machine name (format ID) with values
+   * as the human-readable labels.
+   *
+   * Note: This returns all configured formats and is not permission-aware.
+   * If you need only formats usable by the current user, consider using
+   * filter_formats(\Drupal::currentUser()) instead.
+   *
+   * @return array<string,string> Associative array of format_id => label.
+   *
+   * @throws \Drupal\Component\Plugin\Exception\InvalidPluginDefinitionException
+   * @throws \Drupal\Component\Plugin\Exception\PluginNotFoundException
+   * @see \Drupal\filter\Entity\FilterFormat
+   */
+  private function getPossibleOptions(): array {
+    $storage = \Drupal::entityTypeManager()->getStorage('filter_format');
+    /** @var \Drupal\filter\Entity\FilterFormat[] $formats */
+    $formats = $storage->loadMultiple();
+    $options = [];
+    foreach ($formats as $format) {
+      $options[$format->id()] = $format->label();
+    }
+    asort($options, SORT_NATURAL | SORT_FLAG_CASE);
+    return $options;
+  }
+
+  /**
    * {@inheritdoc}
    */
   public static function propertyDefinitions(FieldStorageDefinitionInterface $field_definition) {
