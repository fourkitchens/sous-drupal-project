diff --git a/src/Utility/WidgetSettings.php b/src/Utility/WidgetSettings.php
new file mode 100644
index 0000000..6ead088
--- /dev/null
+++ b/src/Utility/WidgetSettings.php
@@ -0,0 +1,86 @@
+<?php
+
+namespace Drupal\layout_paragraphs\Utility;
+
+/**
+ * Resolves component menu settings and the default theme's custom template.
+ */
+class WidgetSettings {
+
+  /**
+   * Returns normalized module defaults for the component menu.
+   *
+   * @return array
+   *   The component menu settings.
+   */
+  public static function getDefaults(): array {
+    $settings = \Drupal::config('layout_paragraphs.widget_settings')->getRawData() + [
+      'show_search' => TRUE,
+      'show_icons' => TRUE,
+      'show_description' => TRUE,
+      'display_mode' => 'list',
+    ];
+    return static::normalize($settings);
+  }
+
+  /**
+   * Resolves field overrides, when enabled, against the module defaults.
+   *
+   * @param array $settings
+   *   The field widget or formatter settings.
+   *
+   * @return array
+   *   The effective component menu settings.
+   */
+  public static function resolve(array $settings): array {
+    $defaults = static::getDefaults();
+    $overrides = $settings['widget_settings_source'] ?? 'default';
+    return static::normalize($overrides === 'custom' ? ($settings['widget_settings'] ?? []) + $defaults : $defaults);
+  }
+
+  /**
+   * Normalizes the display mode shared by the menu and its dialog.
+   *
+   * @param array $settings
+   *   The component menu settings.
+   *
+   * @return array
+   *   The normalized settings.
+   */
+  protected static function normalize(array $settings): array {
+    if (!in_array($settings['display_mode'], ['list', 'grid', 'custom'], TRUE)) {
+      $settings['display_mode'] = 'list';
+    }
+    return $settings;
+  }
+
+  /**
+   * Finds a custom menu template in the default theme or its base themes.
+   *
+   * @return string|null
+   *   The Drupal-root-relative template path, or NULL when none exists.
+   */
+  public static function getCustomTemplatePath(): ?string {
+    $theme_name = \Drupal::config('system.theme')->get('default');
+    $themes = \Drupal::service('theme_handler')->listInfo();
+    while (isset($themes[$theme_name])) {
+      $theme = $themes[$theme_name];
+      unset($themes[$theme_name]);
+      $directory = DRUPAL_ROOT . '/' . $theme->getPath() . '/templates';
+      if (is_dir($directory)) {
+        $filename = 'layout-paragraphs-builder-component-menu.html.twig';
+        if (is_file($directory . '/' . $filename)) {
+          return $theme->getPath() . '/templates/' . $filename;
+        }
+        $files = \Drupal::service('file_system')->scanDirectory($directory, '/^layout-paragraphs-builder-component-menu\.html\.twig$/');
+        if ($files) {
+          ksort($files);
+          return substr(reset($files)->uri, strlen(DRUPAL_ROOT) + 1);
+        }
+      }
+      $theme_name = $theme->info['base theme'] ?? '';
+    }
+    return NULL;
+  }
+
+}
