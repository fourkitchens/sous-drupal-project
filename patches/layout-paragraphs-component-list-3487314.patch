+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\layout_paragraphs\Kernel;
+
+use Drupal\Core\Entity\Entity\EntityFormDisplay;
+use Drupal\Core\Entity\Entity\EntityViewDisplay;
+use Drupal\Core\Form\FormState;
+use Drupal\Core\Url;
+use Drupal\Component\Serialization\Json;
+use Drupal\field\Entity\FieldConfig;
+use Drupal\field\Entity\FieldStorageConfig;
+use Drupal\KernelTests\KernelTestBase;
+use Drupal\layout_paragraphs\Controller\ChooseComponentController;
+use Drupal\layout_paragraphs\Form\LayoutParagraphsWidgetSettingsForm;
+use Drupal\layout_paragraphs\LayoutParagraphsLayout;
+use Drupal\layout_paragraphs\Utility\WidgetSettings;
+use Drupal\node\Entity\Node;
+use Drupal\node\Entity\NodeType;
+use Drupal\Tests\SchemaCheckTestTrait;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests component menu configuration, field overrides and rendering.
+ *
+ * @group layout_paragraphs
+ */
+#[RunTestsInSeparateProcesses]
+#[Group('layout_paragraphs')]
+class WidgetSettingsTest extends KernelTestBase {
+
+  use SchemaCheckTestTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'system',
+    'user',
+    'field',
+    'entity_reference_revisions',
+    'paragraphs',
+    'file',
+    'node',
+    'layout_discovery',
+    'layout_paragraphs',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->installEntitySchema('user');
+    $this->installEntitySchema('node');
+    $this->installEntitySchema('paragraph');
+    $this->installConfig(['system', 'layout_paragraphs']);
+    $this->container->get('theme_installer')->install(['stark']);
+    $this->config('system.theme')->set('default', 'stark')->save();
+
+    NodeType::create(['type' => 'lp_test', 'name' => 'LP Test'])->save();
+    FieldStorageConfig::create([
+      'field_name' => 'field_lp',
+      'entity_type' => 'node',
+      'type' => 'entity_reference_revisions',
+      'cardinality' => -1,
+      'settings' => ['target_type' => 'paragraph'],
+    ])->save();
+    FieldConfig::create([
+      'field_name' => 'field_lp',
+      'entity_type' => 'node',
+      'bundle' => 'lp_test',
+    ])->save();
+  }
+
+  /**
+   * Tests installation and upgrading without overwriting existing settings.
+   */
+  public function testInstallAndUpdate(): void {
+    $defaults = [
+      'show_search' => TRUE,
+      'show_icons' => TRUE,
+      'show_description' => TRUE,
+      'display_mode' => 'list',
+    ];
+    $this->assertSame($defaults, array_intersect_key(WidgetSettings::getDefaults(), $defaults));
+    $this->assertConfigSchemaByName('layout_paragraphs.widget_settings');
+
+    $this->container->get('module_handler')->loadInclude('layout_paragraphs', 'install');
+    $this->config('layout_paragraphs.widget_settings')->delete();
+    layout_paragraphs_update_9003();
+    $this->assertSame($defaults, array_intersect_key(WidgetSettings::getDefaults(), $defaults));
+    $this->assertConfigSchemaByName('layout_paragraphs.widget_settings');
+
+    $this->config('layout_paragraphs.widget_settings')
+      ->set('show_search', FALSE)
+      ->set('display_mode', 'grid')
+      ->save();
+    layout_paragraphs_update_9003();
+    $this->assertFalse(WidgetSettings::getDefaults()['show_search']);
+    $this->assertSame('grid', WidgetSettings::getDefaults()['display_mode']);
+  }
+
+  /**
+   * Tests that unchecked settings persist as false through the settings form.
+   */
+  public function testSettingsForm(): void {
+    $form_state = (new FormState())->setValues([
+      'show_search' => NULL,
+      'show_icons' => NULL,
+      'show_description' => NULL,
+      'display_mode' => 'grid',
+    ]);
+    $this->container->get('form_builder')->submitForm(LayoutParagraphsWidgetSettingsForm::class, $form_state);
+    $this->assertSame([], $form_state->getErrors());
+    $settings = WidgetSettings::getDefaults();
+    $this->assertFalse($settings['show_search']);
+    $this->assertFalse($settings['show_icons']);
+    $this->assertFalse($settings['show_description']);
+    $this->assertSame('grid', $settings['display_mode']);
+  }
+
+  /**
+   * Tests both field displays accept inherited and custom settings in config.
+   */
+  public function testFieldDisplaySchema(): void {
+    $form_display = EntityFormDisplay::create([
+      'targetEntityType' => 'node',
+      'bundle' => 'lp_test',
+      'mode' => 'default',
+      'status' => TRUE,
+    ]);
+    $view_display = EntityViewDisplay::create([
+      'targetEntityType' => 'node',
+      'bundle' => 'lp_test',
+      'mode' => 'default',
+      'status' => TRUE,
+    ]);
+    foreach (['default', 'custom'] as $source) {
+      $settings = [
+        'widget_settings_source' => $source,
+        'widget_settings' => $source === 'custom' ? [
+          'show_search' => FALSE,
+          'show_icons' => FALSE,
+          'show_description' => FALSE,
+          'display_mode' => 'grid',
+        ] : [],
+      ];
+      $form_display->setComponent('field_lp', ['type' => 'layout_paragraphs', 'settings' => $settings])->save();
+      $view_display->setComponent('field_lp', ['type' => 'layout_paragraphs_builder', 'settings' => $settings])->save();
+      foreach ([$form_display, $view_display] as $display) {
+        $this->assertConfigSchemaByName($display->getConfigDependencyName());
+        $component = $display->getComponent('field_lp');
+        $this->assertSame($settings['widget_settings'], $component['settings']['widget_settings']);
+      }
+    }
+  }
+
+  /**
+   * Tests rendered menu visibility and field settings precedence.
+   */
+  public function testMenuRenderingAndOverrides(): void {
+    $this->config('layout_paragraphs.widget_settings')
+      ->set('show_search', FALSE)
+      ->set('show_icons', FALSE)
+      ->set('show_description', FALSE)
+      ->set('display_mode', 'grid')
+      ->save();
+
+    // Unused custom values must not override the selected module defaults.
+    $menu = $this->buildMenu([
+      'widget_settings_source' => 'default',
+      'widget_settings' => ['show_icons' => TRUE, 'display_mode' => 'list'],
+    ]);
+    $this->assertSame('grid', $menu['#widget_settings']['display_mode']);
+    $this->assertContains('config:layout_paragraphs.widget_settings', $menu['#cache']['tags']);
+    $markup = (string) $this->container->get('renderer')->renderRoot($menu);
+    $this->assertStringContainsString('data-widget-display="grid"', $markup);
+    $this->assertStringContainsString('Text component', $markup);
+    $this->assertStringNotContainsString('lpb-component-list-search-input', $markup);
+    $this->assertStringNotContainsString('<img', $markup);
+    $this->assertStringNotContainsString('Description of text', $markup);
+
+    // A field's custom list overrides the module's custom display mode.
+    $this->config('layout_paragraphs.widget_settings')->set('display_mode', 'custom')->save();
+    $menu = $this->buildMenu([
+      'widget_settings_source' => 'custom',
+      'widget_settings' => [
+        'show_search' => TRUE,
+        'show_icons' => TRUE,
+        'show_description' => TRUE,
+        'display_mode' => 'list',
+      ],
+    ]);
+    $this->assertSame('layout_paragraphs_builder_component_menu', $menu['#theme']);
+    $markup = (string) $this->container->get('renderer')->renderRoot($menu);
+    $this->assertStringContainsString('data-widget-display="list"', $markup);
+    $this->assertStringContainsString('lpb-component-list-search-input', $markup);
+    $this->assertStringContainsString('<img', $markup);
+    $this->assertStringContainsString('Description of text', $markup);
+  }
+
+  /**
+   * Tests custom mode falls back to the list without a theme template.
+   */
+  public function testMissingCustomTemplate(): void {
+    $this->config('layout_paragraphs.widget_settings')->set('display_mode', 'custom')->save();
+    $this->assertNull(WidgetSettings::getCustomTemplatePath());
+    $menu = $this->buildMenu();
+    $this->assertSame('layout_paragraphs_builder_component_menu', $menu['#theme']);
+    $this->assertSame('list', $menu['#widget_settings']['display_mode']);
+  }
+
+  /**
+   * Tests that dialog sizing uses the same effective settings as the menu.
+   */
+  public function testGridDialogSettings(): void {
+    $this->config('layout_paragraphs.widget_settings')->set('display_mode', 'grid')->save();
+    $node = Node::create(['type' => 'lp_test', 'title' => 'Test node']);
+    $layout = new LayoutParagraphsLayout($node->field_lp);
+    $builder = $this->container->get('plugin.manager.element_info')->createInstance('layout_paragraphs_builder');
+    (new \ReflectionProperty($builder, 'layoutParagraphsLayout'))->setValue($builder, $layout);
+    $method = new \ReflectionMethod($builder, 'insertComponentButton');
+
+    $button = $method->invoke($builder);
+    $options = Json::decode($button['#attributes']['data-dialog-options']);
+    $this->assertSame('min(900px, 90vw)', $options['width']);
+
+    $layout->setSettings([
+      'widget_settings_source' => 'custom',
+      'widget_settings' => ['display_mode' => 'list'],
+    ]);
+    $button = $method->invoke($builder);
+    $options = Json::decode($button['#attributes']['data-dialog-options']);
+    $this->assertArrayNotHasKey('width', $options);
+  }
+
+  /**
+   * Builds a component menu with two available types.
+   *
+   * @param array $settings
+   *   The field widget settings.
+   *
+   * @return array
+   *   The component menu render array.
+   */
+  protected function buildMenu(array $settings = []): array {
+    $node = Node::create(['type' => 'lp_test', 'title' => 'Test node']);
+    $layout = new LayoutParagraphsLayout($node->field_lp, $settings);
+    $types = [];
+    foreach (['text', 'image'] as $id) {
+      $types[$id] = [
+        'id' => $id,
+        'label' => ucfirst($id) . ' component',
+        'description' => 'Description of ' . $id,
+        'image' => '/test-' . $id . '.svg',
+        'is_section' => FALSE,
+        'url_object' => Url::fromUri('https://example.com/add/' . $id),
+      ];
+    }
+    $controller = ChooseComponentController::create($this->container);
+    $method = new \ReflectionMethod($controller, 'componentMenu');
+    return $method->invoke($controller, $types, $layout);
+  }
+
+}
