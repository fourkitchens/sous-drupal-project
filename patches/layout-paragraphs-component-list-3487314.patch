diff --git a/src/Form/LayoutParagraphsWidgetSettingsForm.php b/src/Form/LayoutParagraphsWidgetSettingsForm.php
new file mode 100644
index 0000000..a1d8fd9
--- /dev/null
+++ b/src/Form/LayoutParagraphsWidgetSettingsForm.php
@@ -0,0 +1,74 @@
+<?php
+
+namespace Drupal\layout_paragraphs\Form;
+
+use Drupal\Core\Form\ConfigFormBase;
+use Drupal\Core\Form\FormStateInterface;
+use Drupal\layout_paragraphs\Utility\WidgetSettings;
+
+/**
+ * Defines a form for Layout Paragraphs widget settings.
+ */
+class LayoutParagraphsWidgetSettingsForm extends ConfigFormBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getFormId() {
+    return 'layout_paragraphs_widget_settings';
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function getEditableConfigNames() {
+    return ['layout_paragraphs.widget_settings'];
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function buildForm(array $form, FormStateInterface $form_state) {
+    $settings = WidgetSettings::getDefaults();
+    foreach ([
+      'show_search' => $this->t('Show search'),
+      'show_icons' => $this->t('Show icons'),
+      'show_description' => $this->t('Show description'),
+    ] as $key => $title) {
+      $form[$key] = [
+        '#type' => 'checkbox',
+        '#title' => $title,
+        '#default_value' => $settings[$key],
+      ];
+    }
+    $form['display_mode'] = [
+      '#type' => 'select',
+      '#title' => $this->t('Display mode'),
+      '#options' => [
+        'list' => $this->t('List'),
+        'grid' => $this->t('Grid'),
+        'custom' => $this->t('Custom'),
+      ],
+      '#default_value' => $settings['display_mode'],
+      '#description' => $this->t('Custom uses <code>layout-paragraphs-builder-component-menu.html.twig</code> from the default theme. If no template is found, the list display is used.'),
+    ];
+    if ($settings['display_mode'] === 'custom' && !WidgetSettings::getCustomTemplatePath()) {
+      $this->messenger()->addWarning($this->t('The default theme does not provide a <code>layout-paragraphs-builder-component-menu.html.twig</code> template. The list display will be used.'));
+    }
+    return parent::buildForm($form, $form_state);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function submitForm(array &$form, FormStateInterface $form_state) {
+    $this->config('layout_paragraphs.widget_settings')
+      ->set('show_search', (bool) $form_state->getValue('show_search'))
+      ->set('show_icons', (bool) $form_state->getValue('show_icons'))
+      ->set('show_description', (bool) $form_state->getValue('show_description'))
+      ->set('display_mode', $form_state->getValue('display_mode'))
+      ->save();
+    parent::submitForm($form, $form_state);
+  }
+
+}
