@@ -0,0 +1,109 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\layout_paragraphs\Kernel;
+
+use Drupal\KernelTests\KernelTestBase;
+use Drupal\layout_paragraphs\Utility\WidgetSettings;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests custom component menus through the normal theme renderer.
+ *
+ * @group layout_paragraphs
+ */
+#[RunTestsInSeparateProcesses]
+#[Group('layout_paragraphs')]
+class WidgetCustomTemplateTest extends KernelTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'system',
+    'user',
+    'field',
+    'entity_reference_revisions',
+    'paragraphs',
+    'file',
+    'node',
+    'layout_discovery',
+    'layout_paragraphs',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->container->get('theme_installer')->install([
+      'stark',
+      'layout_paragraphs_widget_test',
+      'layout_paragraphs_widget_test_subtheme',
+    ]);
+  }
+
+  /**
+   * Tests the frontend template while an administration theme is active.
+   */
+  public function testCustomTemplateWithAdminTheme(): void {
+    $this->config('system.theme')
+      ->set('default', 'layout_paragraphs_widget_test')
+      ->set('admin', 'stark')
+      ->save();
+    $this->activateTheme('stark');
+
+    $this->assertStringEndsWith('/templates/components/layout-paragraphs-builder-component-menu.html.twig', WidgetSettings::getCustomTemplatePath());
+    $build = $this->buildMenu();
+    $output = (string) $this->container->get('renderer')->renderRoot($build);
+
+    $this->assertStringContainsString('custom-component-menu', $output);
+    $this->assertStringContainsString('data-test="custom-menu"', $output);
+    $this->assertStringContainsString('No components to add.', $output);
+    $this->assertContains('layout_paragraphs_widget_test/component_menu', $build['#attached']['library']);
+    $this->assertSame('stark', $this->container->get('theme.manager')->getActiveTheme()->getName());
+  }
+
+  /**
+   * Tests inherited templates and normal base-theme preprocessing.
+   */
+  public function testBaseThemeTemplateAndPreprocess(): void {
+    $this->config('system.theme')
+      ->set('default', 'layout_paragraphs_widget_test_subtheme')
+      ->save();
+    $this->activateTheme('layout_paragraphs_widget_test_subtheme');
+
+    $this->assertStringContainsString('/layout_paragraphs_widget_test/templates/components/', WidgetSettings::getCustomTemplatePath());
+    $build = $this->buildMenu();
+    $output = (string) $this->container->get('renderer')->renderRoot($build);
+
+    $this->assertStringContainsString('custom-component-menu', $output);
+    $this->assertStringContainsString('data-widget-preprocessed="true"', $output);
+    $this->assertContains('layout_paragraphs_widget_test/component_menu', $build['#attached']['library']);
+  }
+
+  /**
+   * Activates a theme and rebuilds its registry.
+   */
+  protected function activateTheme(string $theme): void {
+    $this->container->get('theme.manager')->setActiveTheme($this->container->get('theme.initialization')->getActiveThemeByName($theme));
+    $this->container->get('theme.registry')->reset();
+  }
+
+  /**
+   * Builds an empty menu, including the normal status message render element.
+   */
+  protected function buildMenu(): array {
+    return [
+      '#theme' => 'layout_paragraphs_builder_component_menu__custom',
+      '#attributes' => ['data-test' => 'custom-menu'],
+      '#types' => ['layout' => [], 'content' => []],
+      '#empty_message' => 'No components to add.',
+      '#status_messages' => ['#type' => 'status_messages'],
+      '#widget_settings' => WidgetSettings::getDefaults(),
+    ];
+  }
+
+}
