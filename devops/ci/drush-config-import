#!/bin/bash

set -euo pipefail

P_SITE="${1:-${TERMINUS_SITE:-}}"
P_ENV="${2:-${TERMINUS_ENV:-}}"

if [[ -z "$P_SITE" ]] || [[ -z "$P_ENV" ]]; then
  echo "Provide a site and environment, or set TERMINUS_SITE and TERMINUS_ENV." >&2
  exit 1
fi

# Let the destination site's Drush deploy using its own configuration directory.
exec terminus -n drush "$P_SITE.$P_ENV" -- deploy --yes
