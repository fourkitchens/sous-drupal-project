{
  "name": "sous-project",
  "version": "0.0.1",
  "description": "A starter kit for a Drupal project",
  "scripts": {
    "setup": "./devops/scripts/setup.sh",
    "confim": "./devops/scripts/confim.sh",
    "confex": "./devops/scripts/confex.sh",
    "get-db": "./devops/scripts/get-db.sh",
    "install-recipe": "./devops/scripts/install-recipe.sh",
    "husky:commit-msg": "commitlint --edit $1",
    "husky:pre-commit": "npm run lint",
    "import-data": "./devops/scripts/import-data.sh",
    "lint": "npm run lint:starter",
    "lint:js": "eslint .",
    "lint:php": "node devops/scripts/lint-php.mjs",
    "lint:styles": "npm --prefix web/themes/custom/sous-project run lint-styles",
    "prettier": "npm --prefix web/themes/custom/sous-project run prettier -- --check",
    "local-data-bak": "./devops/scripts/local-data-bak.sh",
    "prepare": "husky",
    "publish": "semantic-release",
    "publish-test": "semantic-release --dry-run --debug",
    "rebuild": "./devops/scripts/rebuild.sh",
    "theme-build": "./devops/scripts/theme-build.sh",
    "theme-watch": "./devops/scripts/theme-watch.sh",
    "sous-build": "./devops/scripts/sous-build.sh",
    "lint:starter": "npm run lint:php && npm run lint:js",
    "lint:theme": "npm --prefix web/themes/custom/sous-project run lint-js && npm --prefix web/themes/custom/sous-project run lint-styles",
    "lint:project": "npm run lint:starter && npm run lint:theme",
    "theme-ci": "npm --prefix web/themes/custom/sous-project ci --include=dev",
    "theme-storybook": "npm --prefix web/themes/custom/sous-project run storybook-build -- --output-dir ../../../storybook",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "check:environment": "./devops/scripts/check-environment.sh"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fourkitchens/sous-drupal-project.git"
  },
  "keywords": [
    "sous"
  ],
  "author": "Four Kitchens",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@emulsify/cli": "^2.4.1",
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "semantic-release": "^25.0.9",
    "conventional-changelog-conventionalcommits": "^10.4.1"
  },
  "overrides": {
    "@semantic-release/release-notes-generator": {
      "conventional-changelog-writer": "^9.3.0"
    },
    "@emulsify/cli": {
      "simple-git": "^4.0.2"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "private": true
}
