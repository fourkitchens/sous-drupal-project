{
  "name": "sous-project",
  "version": "0.0.1",
  "description": "A starter kit for a Drupal project",
  "config": {
    "theme": "sous-project"
  },
  "scripts": {
    "setup": "sh devops/scripts/setup.sh",
    "rebuild": "sh devops/scripts/rebuild.sh",
    "confim": "ddev drush deploy -y",
    "confex": "ddev drush config:export -y",
    "get-db": "sh devops/scripts/get-db.sh",
    "install-recipe": "sh devops/scripts/install-recipe.sh",
    "import-data": "sh devops/scripts/import-data.sh",
    "lint": "npm run lint:php && npm run lint:js && (test ! -d \"web/themes/custom/$npm_package_config_theme\" || npm --prefix \"web/themes/custom/$npm_package_config_theme\" run lint)",
    "lint:js": "eslint .",
    "lint:php": "node devops/scripts/lint-php.mjs",
    "lint:styles": "npm --prefix \"web/themes/custom/$npm_package_config_theme\" run lint-styles",
    "prettier": "npm --prefix \"web/themes/custom/$npm_package_config_theme\" run prettier -- --check",
    "local-data-bak": "ddev export-db --file=reference/db-$(date +%Y-%m-%d-%H%M).sql.gz",
    "prepare": "husky",
    "theme-build": "npm --prefix \"web/themes/custom/$npm_package_config_theme\" run build",
    "theme-watch": "npm --prefix \"web/themes/custom/$npm_package_config_theme\" run develop",
    "theme-ci": "npm --prefix \"web/themes/custom/$npm_package_config_theme\" ci --include=dev",
    "theme-storybook": "npm --prefix \"web/themes/custom/$npm_package_config_theme\" run storybook-build -- --output-dir ../../../storybook",
    "release": "semantic-release"
  },
  "keywords": [
    "sous"
  ],
  "author": "Four Kitchens",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@emulsify/cli": "^2.4.1",
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "semantic-release": "^25.0.9",
    "conventional-changelog-conventionalcommits": "^10.4.1"
  },
  "overrides": {
    "@semantic-release/release-notes-generator": {
      "conventional-changelog-writer": "^9.3.0"
    },
    "@emulsify/cli": {
      "simple-git": "^4.0.2"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "private": true
}
